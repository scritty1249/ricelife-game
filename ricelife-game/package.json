{
    "name": "ricelife-game",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build:client": "node ./build/client.js",
        "build:server": "node ./build/server.js",
        "build": "npm run build:client && npm run build:server",
        "dev": "node ./build/client.js --dev && node ./build/server.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1095.0",
        "@aws-sdk/s3-request-presigner": "^3.1095.0",
        "@aws-sdk/client-dynamodb": "^3.1095.0",
        "@aws-sdk/lib-dynamodb": "^3.1095.0",
        "@vercel/oidc-aws-credentials-provider": "^3.1.4",
        "@discord/embedded-app-sdk": "^2.5.0",
        "tweetnacl": "^1.0.3",
        "@server/lib": "file:./dist/lib"
    },
    "devDependencies": {
        "node": "22.11.0",
        "esbuild": "latest"
    },
    "allowScripts": {
        "esbuild": true,
        "node": true
    }
}
